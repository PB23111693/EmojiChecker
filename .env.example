# ===== 应用 =====
APP_ENV=dev
APP_NAME=表情符号课堂情绪检查器
LOG_LEVEL=INFO
# 生产环境必须设置为随机长字符串，且不得提交到仓库
SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
# 前端开发服务器地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 数据库 =====
# 默认 SQLite，相对路径以项目根目录为基准
DATABASE_URL=sqlite:///./data/se_emoji.db
# MySQL 8 示例，需先执行 db/schema_mysql.sql
# DATABASE_URL=mysql+pymysql://se_emoji:change_me@127.0.0.1:3306/se_emoji?charset=utf8mb4
AUTO_CREATE_TABLES=true

# ===== 业务规则 =====
# 手动反馈时间片长度，单位秒；0 表示不限制
MANUAL_SLOT_SECONDS=30
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# 教师自助注册邀请码，留空则关闭该入口
TEACHER_INVITE_CODE=
# 管理员自助注册邀请码，留空则关闭该入口；生产环境使用长随机值
ADMIN_INVITE_CODE=

# ===== AI 服务 =====
AI_SERVICE_KEY=dev-ai-service-key-change-me
AI_DEVICE_ID=demo-device-01
# 允许上报的课堂 ID，留空表示不限制
AI_ALLOWED_SESSION_IDS=
# 观测时间与服务器时间允许的偏差
AI_MAX_PAST_SECONDS=60
AI_MAX_FUTURE_SECONDS=5
